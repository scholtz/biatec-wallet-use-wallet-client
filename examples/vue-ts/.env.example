# OPTIONAL WalletConnect v2 project id (free at https://cloud.reown.com).
# Leave it unset and only Biatec Direct and Liquid Auth are offered. Set it to also offer
# WalletConnect, the only way to reach a wallet on another device for post-quantum, Ledger
# and multisig accounts.
# VITE_WC_PROJECT_ID=your-project-id

# Optional: point the Liquid Auth transport at a self-hosted service.
# Defaults to Biatec's hosted service if unset.
VITE_LIQUID_ORIGIN=https://liquid.biatec.io
