# sets a public one so the hosted example also shows the WalletConnect tab; remove the line and
# the demo offers only Direct and Liquid Auth. A local `.env`
# still overrides this for `pnpm dev`.
VITE_WC_PROJECT_ID=1fec64728bc24fb27e81cdbbe8e8ecad
